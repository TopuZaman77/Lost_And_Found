# Database connection used by Drizzle ORM.
DATABASE_URL=mysql://USERNAME:PASSWORD@localhost:3306/diu_foundhub

# Use a long random value in production to sign secure browser sessions.
JWT_SECRET=replace_with_a_long_random_secret

# Optional: activates real outbound email; without these values, in-app alerts still work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DIU FoundHub <alerts@example.com>

# Optional project configuration values. Leave blank for local manual-auth development.
VITE_APP_ID=
OWNER_OPEN_ID=
OWNER_NAME=
